generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  plan          String    @default("free")
  /** null = permanent access (existing/approved users). Set to now+3d on registration. */
  trialEndsAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  studioState         UserStudioState?
  studioBlobs         StudioBlob[]
  studioNodeMediaVersions StudioNodeMediaVersion[]
}

/// Binary media for Studio nodes (S3-compatible object storage, e.g. MinIO in Docker Compose).
model StudioBlob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  s3Key     String   @unique
  mimeType  String
  byteSize  Int
  createdAt DateTime @default(now())
  /** Canvas / workflow context at upload time (optional for legacy rows). */
  sourceNodeId    String?
  sourceNodeType  String?
  sourceNodeLabel String?
  mediaFieldKind  String?

  versions StudioNodeMediaVersion[]

  @@index([userId, createdAt])
}

/// Prior outputs per canvas node (for restore / history UI). Not a full base64 chain in JSON.
model StudioNodeMediaVersion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId    String
  blobId    String
  blob      StudioBlob @relation(fields: [blobId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, nodeId, kind])
}

/// Encrypted API key + canvas snapshot per user (synced across devices).
model UserStudioState {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedApiKey     String?
  nodes               Json
  edges               Json
  workflows           Json
  videoJobs           Json
  dynamicHandleCounts Json
  theme               String   @default("dark")
  updatedAt           DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
